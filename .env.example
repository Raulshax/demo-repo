# Runtime connection: a NON-owner role so Row Level Security is enforced.
# (Falls back to DATABASE_URL if APP_DATABASE_URL is unset.)
APP_DATABASE_URL=postgres://procure_app:app_dev_pw@localhost:5432/procure
# Owner connection: used only by migrations and seeding.
DATABASE_OWNER_URL=postgres://procure_owner:owner_dev_pw@localhost:5432/procure
# Optional. Without it, the deterministic extraction/normalisation engine is used.
ANTHROPIC_API_KEY=
